# Copiez ce fichier en .env et ajustez. docker-compose lit automatiquement .env.

# ============================================================
#  Migration edge functions → backend : garder Supabase (DB + Auth)
# ============================================================

# --- Base de données : Postgres de Supabase (chaîne de connexion directe / pooler) ---
# Récupérable dans Supabase > Project Settings > Database > Connection string (URI).
# Exemple : postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_SSL=true

# --- Auth Supabase (vérification des JWT côté Node) ---
SUPABASE_URL=https://ntvwbafvjgzsjoumtcmb.supabase.co
SUPABASE_ANON_KEY=

# --- Passerelle LLM (chat + génération) ---
LOVABLE_API_KEY=
LOVABLE_GATEWAY_URL=https://ai.gateway.lovable.dev/v1/chat/completions
CHAT_MODEL=google/gemini-3-flash-preview

# ============================================================
#  Orchestration multi-fournisseurs d'IA (service python-ia)
#  Un fournisseur est ACTIVÉ dès que sa clé est renseignée. Le routeur choisit le
#  modèle selon le type de tâche ; l'utilisateur peut imposer un fournisseur.
# ============================================================
# Anthropic (déjà utilisé)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Google Gemini (endpoint compatible OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# xAI (Grok)
XAI_API_KEY=
XAI_MODEL=grok-2-latest
# Qwen (DashScope, compatible OpenAI)
QWEN_API_KEY=
QWEN_MODEL=qwen-max
# Modèle local (Ollama / LM Studio / vLLM) — activé si LOCAL_LLM_URL est défini
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_KEY=

# Fournisseur par défaut (sinon : 1er configuré). Routage par tâche : LLM_ROUTING (JSON).
# Ex : LLM_ROUTING={"code":"deepseek","chat":"openai","reasoning":"anthropic"}
LLM_DEFAULT_PROVIDER=
LLM_ROUTING=

# Fournisseur du CHAT streaming (famille compatible OpenAI : openai|gemini|mistral|
# deepseek|xai|qwen|local). Vide = 1er configuré (OpenAI prioritaire). Le chat n'est
# plus lié à un fournisseur unique.
CHAT_PROVIDER=

# ============================================================
#  Recherche web (moteur de recherche KB-first, service node-api)
#  Sans clé : la recherche se limite à la base de connaissances + synthèse du modèle.
#  Renseigner UNE clé suffit. WEB_SEARCH_PROVIDER force le choix (tavily|serper|brave).
# ============================================================
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Fournisseur de stockage de la base de connaissances (supabase aujourd'hui ; gcp plus tard)
KNOWLEDGE_STORE_PROVIDER=supabase

# ============================================================
#  Postgres LOCAL (uniquement pour la démo /api/analyze — facultatif)
# ============================================================
POSTGRES_USER=soulbah
POSTGRES_PASSWORD=soulbah
POSTGRES_DB=soulbah

# --- Ports exposés ---
NODE_API_PORT=3000
PYTHON_IA_PORT=8000
RUST_COMPUTE_PORT=8080
