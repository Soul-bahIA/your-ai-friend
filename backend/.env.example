# Copiez ce fichier en .env et ajustez. docker-compose lit automatiquement .env.
# Hors Docker (node-api lancé avec tsx) : `set -a && source <(tr -d '\r' < ../.env) && set +a`.

# ============================================================
#  Environnement (contrat LOT 1 §1) : dev | test | staging | production (défaut dev)
# ============================================================
# Hors dev/test, node-api REFUSE de démarrer sans IA_SERVICE_TOKEN, sans PG_SSL_CA
# quand DATABASE_SSL=true, avec une base distante sans DATABASE_SSL=true, ou avec des
# paramètres TLS (sslmode…) dans DATABASE_URL (python-ia refuse aussi sans IA_SERVICE_TOKEN).
# En dev uniquement, /health/deep est public.
SOULBAH_ENV=dev

# ============================================================
#  node-api : réseau, CORS, limites
# ============================================================
# Interface d'écoute. Défaut 127.0.0.1 (local uniquement) ; docker-compose force 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# Proxy de confiance (IP réelle du client pour la limitation de débit) :
# vide/false = connexion directe (défaut) ; true = tout X-Forwarded-For (proxy maîtrisé
# uniquement) ; n = nombre de sauts ; sinon liste d'IP/CIDR séparées par des virgules.
TRUST_PROXY=
# Port publié sur l'hôte par docker-compose pour node-api (python-ia/rust restent internes).
NODE_API_PORT=3000
# Origines web autorisées (CORS), séparées par des virgules. Vide = localhost:8080 / 127.0.0.1:8080 / localhost:5173 (console de test).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
# Limitation de débit (requêtes / minute) : globale (par utilisateur, sinon par IP),
# agent local (poll/évènements), routes coûteuses (chat, génération, recherche…).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AGENT=1200
RATE_LIMIT_EXPENSIVE=20

# ============================================================
#  Base de données : Postgres de Supabase (chaîne de connexion directe / pooler)
# ============================================================
# Supabase > Project Settings > Database > Connection string (URI).
# Exemple : postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_SSL=true
# Vérification TLS du serveur Postgres : chemin d'un certificat CA (PEM), p.ex. le
# « SSL certificate » téléchargeable dans Supabase > Database settings. Si défini :
# rejectUnauthorized=true avec ce CA. Si vide : chiffré SANS vérification (avertissement
# au démarrage ; REFUS de démarrer hors dev/test).
# Ne mettez AUCUN paramètre TLS dans DATABASE_URL (sslmode, ssl, sslrootcert, sslcert…) : pg
# les ferait primer sur DATABASE_SSL/PG_SSL_CA (sslmode=no-verify coupe la vérification).
# Hors dev/test ils EMPÊCHENT le démarrage ; en dev, avec PG_SSL_CA ils sont retirés.
# Hors dev/test, une base DISTANTE (hôte autre que localhost / 127.x / ::1 / nom de service
# docker sans point comme « postgres ») exige DATABASE_SSL=true (pas de Postgres en clair).
PG_SSL_CA=
# Délai max d'une requête SQL (ms) — statement_timeout côté serveur.
PG_STATEMENT_TIMEOUT_MS=30000

# --- Auth Supabase (vérification des JWT côté Node, résultat mis en cache 15 s ;
#     POST /api/auth/logout l'invalide immédiatement) ---
SUPABASE_URL=https://ntvwbafvjgzsjoumtcmb.supabase.co
SUPABASE_ANON_KEY=

# --- Auth de DÉVELOPPEMENT (LOT 3, hors Docker) : AUTH_MODE=dev-local remplace la vérification
#     Supabase par un jeton partagé (un seul utilisateur de dev). Accepté UNIQUEMENT si
#     SOULBAH_ENV=dev|test, HOST en boucle locale, et pour les requêtes venant de la boucle
#     locale (sinon : refus de démarrer / 403). `bash scripts/dev_db/dev_db.sh up` crée la base
#     locale jetable et génère ces valeurs dans .dev_db/dev.env (docs/LOT3_DEV_LOCAL.md).
AUTH_MODE=supabase
DEV_LOCAL_USER_ID=
DEV_LOCAL_TOKEN=

# --- Sécurité V2 (LOT 6) ---
# Secret HMAC des jetons d'approbation par action (≥ 32 caractères). OBLIGATOIRE hors
# SOULBAH_ENV=dev|test ; vide en dev = secret éphémère par processus (les approbations ne
# survivent pas à un redémarrage de node-api).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOULBAH_APPROVAL_SECRET=
# Valeurs à rédiger dans TOUTE sortie (journaux, lignes agent_events/agent_tasks, prompts,
# audit), séparées par « ; » — p. ex. un secret canari de test. Vide = motifs intégrés seulement.
SOULBAH_REDACT_VALUES=

# ============================================================
#  Service IA (python-ia)
# ============================================================
# URL vue par node-api. Docker : http://python-ia:8000 (forcé par docker-compose).
IA_SERVICE_URL=http://localhost:8000
# Jeton partagé node-api → python-ia (en-tête x-ia-token). Le MÊME pour les deux services.
# OBLIGATOIRE hors SOULBAH_ENV=dev|test.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IA_SERVICE_TOKEN=
# Dossier média partagé : python-ia y écrit les MP4/PDF, node-api les sert sous /media/.
# Vide = backend/media. docker-compose utilise un volume partagé (python-ia : /app/media,
# node-api : /data/media en lecture seule).
MEDIA_DIR=
# Rétention des médias NON référencés par une formation (video_url/pdf_url), en jours.
# Purge à la maintenance horaire de node-api ; 0 = jamais. Volume en lecture seule
# (docker) : la purge est ignorée côté node-api.
MEDIA_RETENTION_DAYS=30

# ============================================================
#  Orchestration multi-fournisseurs d'IA (python-ia + chat de node-api)
#  Un fournisseur est ACTIVÉ dès que sa clé est renseignée.
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
XAI_API_KEY=
XAI_MODEL=grok-2-latest
QWEN_API_KEY=
QWEN_MODEL=qwen-max
# Modèle local (Ollama / LM Studio / vLLM) — activé si LOCAL_LLM_URL est défini
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_KEY=
# V3 LOT 3 : serveurs locaux par rôle (facultatifs), sinon LOCAL_LLM_URL sert tous les rôles.
# Chaîne d'une tâche : serveur du rôle → LOCAL_LLM_URL → LOCAL_LLM_URL_SMALL (repli Grand → Petit) ;
# en HYBRID, le local passe avant le cloud (SOULBAH_MODEL_POLICY=cloud-first pour l'ordre V2).
# Hors HYBRID, chaque URL doit viser une machine de l'utilisateur (sinon refusée).
# LOCAL_LLM_URL_PLANNER / _EVALUATOR / _VISION / _CHEAP / _CODE / _SMALL et LOCAL_LLM_MODEL_<RÔLE>
# Exemple : LOCAL_LLM_URL_CODE=http://127.0.0.1:8092/v1  LOCAL_LLM_MODEL_CODE=qwen2.5-coder-1.5b-instruct-q4_k_m

# Fournisseur FACTICE (LOT 3) : 1 = python-ia n'utilise QUE app/providers/fake.py (réponses
# déterministes, aucune clé, aucun appel réseau, aucun coût) — pile de dev et tests. Refusé
# hors SOULBAH_ENV=dev|test (le service ne démarre pas). Vide/0 = fournisseurs réels.
LLM_FAKE_PROVIDER=

# Fournisseur par défaut (sinon : 1er configuré). Routage par tâche : LLM_ROUTING (JSON).
# Ex : LLM_ROUTING={"code":"deepseek","chat":"openai","reasoning":"anthropic"}
LLM_DEFAULT_PROVIDER=
LLM_ROUTING=
# Fournisseurs qu'un CLIENT peut imposer (champ `provider` des requêtes), séparés par des
# virgules, en minuscules (lu par node-api ET python-ia). Vide = aucune surcharge : tout
# `provider` fourni est refusé (400).
LLM_ALLOWED_OVERRIDES=

# --- Routeur de modèles python-ia (LOT 1) ---
# Modèle par rôle : "[fournisseur:]modèle" (appliqué si le fournisseur retenu est celui du
# profil). Vides = défauts du routeur (planner/evaluator/vision : claude-opus-5-5 ; cheap : haiku).
LLM_MODEL_PLANNER=
LLM_MODEL_EVALUATOR=
LLM_MODEL_VISION=
LLM_MODEL_CHEAP=
# Effort de raisonnement par rôle (low|medium|high) ; vide = défaut du rôle.
LLM_EFFORT_PLANNER=
LLM_EFFORT_EVALUATOR=
LLM_EFFORT_VISION=
LLM_EFFORT_CHEAP=
LLM_EFFORT_DEFAULT=
# Repli sur panne (429, 5xx, délai, crédits) : ordre des fournisseurs et nombre de sauts.
# Jamais de repli quand un client a imposé `provider`.
LLM_FALLBACK_ORDER=anthropic,openai,gemini,mistral,deepseek,xai,qwen,local
LLM_MAX_HOPS=3
# Disjoncteur par fournisseur : N échecs consécutifs → ouvert pendant N secondes.
LLM_CB_THRESHOLD=3
LLM_CB_COOLDOWN_S=30
# Capacités déclarées (JSON) — vision=false par défaut : une image n'est jamais envoyée à
# un modèle non-vision. Ex. : {"openai:gpt-4o": {"vision": true}}
LLM_CAPABILITIES=
# Délai par appel fournisseur (s), tentatives SDK, plancher max_tokens des modèles à réflexion.
LLM_TIMEOUT_S=100
LLM_MAX_RETRIES=1
LLM_THINKING_MIN_MAX_TOKENS=16000
# node-api envoie l'en-tête x-deadline-ms (budget restant) : python-ia ne travaille jamais
# au-delà de l'abandon de node ; l'usage LLM revient dans l'en-tête x-llm-usage (journalisé).

# --- Coûts et budgets du routeur (LOT 5) ---
# Plafond de max_tokens par profil (entier > 0) ; vide = valeur demandée par l'appelant.
LLM_MAX_OUTPUT_TOKENS_PLANNER=
LLM_MAX_OUTPUT_TOKENS_EVALUATOR=
LLM_MAX_OUTPUT_TOKENS_VISION=
LLM_MAX_OUTPUT_TOKENS_CHEAP=
# Plafond de coût cumulé par jour UTC (USD, estimé d'après shared/models/pricing.json, compteur
# en mémoire du processus). Atteint → 402 « budget » avant tout nouvel appel, sans repli ;
# avertissement journalisé à 80 %. Vide, 0 ou invalide = illimité. Un modèle au tarif inconnu
# ne consomme pas le budget (compté dans unknown_cost_calls de GET /v2/models).
LLM_DAILY_BUDGET_USD=
# Tarifs : copie intégrée de shared/models/pricing.json. LLM_PRICING (JSON, même forme que la
# clé "providers") ajoute ou corrige un tarif, ex. {"local": {"*": {"input": 0, "output": 0}}} ;
# LLM_PRICING_FILE impose un autre fichier pricing.json (fusionné avec la copie intégrée).
LLM_PRICING=
LLM_PRICING_FILE=

# Synthèse vocale des vidéos de formation (python-ia, OpenAI TTS)
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Narrations TTS générées en parallèle (1–8).
VIDEO_TTS_CONCURRENCY=3
# Taille max d'un corps de requête accepté par python-ia (octets).
IA_MAX_BODY_BYTES=41943040

# Chat streaming de node-api (famille compatible OpenAI : openai|gemini|mistral|
# deepseek|xai|qwen|local). Vide = 1er configuré (OpenAI prioritaire).
CHAT_PROVIDER=
# Modèle du chat : appliqué UNIQUEMENT au fournisseur choisi par CHAT_PROVIDER
# (jamais à un fournisseur de repli d'un autre éditeur). Vide = <FOURNISSEUR>_MODEL.
CHAT_MODEL=
# Endpoint OpenAI (proxy compatible éventuel)
OPENAI_URL=https://api.openai.com/v1/chat/completions

# Embeddings de la base de connaissances (RAG) — utilisent OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_URL=https://api.openai.com/v1/embeddings

# ============================================================
#  Recherche web (moteur de recherche KB-first, service node-api)
#  Sans clé : la recherche se limite à la base de connaissances + synthèse du modèle.
#  Renseigner UNE clé suffit. WEB_SEARCH_PROVIDER force le choix (tavily|serper|brave).
# ============================================================
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Fournisseur de stockage de la base de connaissances (supabase aujourd'hui ; gcp plus tard)
KNOWLEDGE_STORE_PROVIDER=supabase

# ============================================================
#  Agent local & maintenance
# ============================================================
# Tâche 'in_progress' sans signe de vie depuis ce délai → remise en file (max 3 fois)
# par le reaper GLOBAL de node-api (verrou consultatif : une seule instance l'exécute).
# Délai des appels node-api → python-ia (ms, défaut 120000) : à allonger avec un modèle local sur CPU,
# en cohérence avec LLM_TIMEOUT_S / LLM_BUDGET_S de python-ia.
IA_TIMEOUT_MS=120000

# --- V3 (LOT 1) : configuration centrale (agent, python-ia, node-api) ---
# Ordre : valeurs par défaut < fichier soulbah.config.json (racine du dépôt, ou chemin dans
# SOULBAH_CONFIG) < ces variables. Exemple : shared/config/soulbah.config.example.json.
# Toute valeur invalide BLOQUE le démarrage (une faute de frappe n'ouvre jamais le cloud).
# SOULBAH_CONFIG=C:\cheminers\soulbah.config.json
# Mode : OFFLINE (aucune connexion externe) | LOCAL_INTERNET (modèles locaux, Internet pour la
# recherche, la documentation, git) | HYBRID (défaut : fournisseurs cloud configurés autorisés).
SOULBAH_MODE=HYBRID
# Profil de ressources : ECO (2 agents au plus) | BALANCED | MAX.
SOULBAH_RESOURCE_PROFILE=BALANCED
# Politique de modèles (V3 LOT 3) : auto (local d'abord, puis cloud en HYBRID) | local-only (jamais
# de cloud) | cloud-first (ordre V2) | fournisseur[:modèle] imposé, ex. local:qwen2.5-1.5b-instruct-q4_k_m.
SOULBAH_MODEL_POLICY=auto
# Hôtes joignables même en OFFLINE (machines de l'utilisateur, ex. serveur de modèles du réseau
# local), séparés par des virgules. Le bouclage et les noms sans point (services Docker) le sont toujours.
SOULBAH_NETWORK_ALLOW_HOSTS=
# Interrupteurs de l'agent : contrôle souris / clavier / applications / téléphone, enregistrement d'écran.
SOULBAH_COMPUTER_CONTROL=true
SOULBAH_RECORDING=true
# Moteur d'auto-amélioration contrôlée (V3 LOT 14).
SOULBAH_SELF_IMPROVEMENT=false

# --- V2 (LOT 7) : sessions, scheduler, runtime ---
# Plafond GLOBAL d'agents en parallèle (1–32, réduit à 2 par le profil ECO) ; le plafond effectif
# est le minimum avec le réglage utilisateur (soulbah.user_settings), la mission
# (sessions.max_parallel_agents) et les slots du runtime.
SOULBAH_MAX_PARALLEL_AGENTS=6
# Durée d'un bail de tâche (s), prolongé par le keepalive du runtime ; bail expiré → RETRYING.
SOULBAH_LEASE_SECONDS=90
# Période du scheduler V2 (s) et du flux SSE /api/v2/stream (ms).
SOULBAH_SCHEDULER_INTERVAL_SECONDS=5
SOULBAH_STREAM_INTERVAL_MS=2000
# Version minimale (semver) d'un runtime V2 acceptée à l'enregistrement (LOT 8) ; vide = toutes.
SOULBAH_RUNTIME_MIN_VERSION=
# LOT 11 : 1 = /api/agent/goal crée une mission V2 (gabarit desktop_goal, approbation du plan)
# au lieu d'une tâche V1 directe. À activer quand le runtime V2 (agent/Lancer_Runtime.bat) tourne.
SOULBAH_V2_GOAL_BRIDGE=
AGENT_TASK_STALE_SECONDS=180
# Période du reaper (secondes, min 10).
REAPER_INTERVAL_SECONDS=60
# Formation/application bloquée en « Génération... »/« En cours » au-delà → 'Erreur'.
STALE_GENERATION_MINUTES=30

# ============================================================
#  Postgres LOCAL (uniquement pour la démo /api/analyze — facultatif)
# ============================================================
POSTGRES_USER=soulbah
POSTGRES_PASSWORD=soulbah
POSTGRES_DB=soulbah
