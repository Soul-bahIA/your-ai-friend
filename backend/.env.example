# Copiez ce fichier en .env et ajustez. docker-compose lit automatiquement .env.
# Hors Docker (node-api lancé avec tsx) : `set -a && source <(tr -d '\r' < ../.env) && set +a`.

# ============================================================
#  Environnement (contrat LOT 1 §1) : dev | test | staging | production (défaut dev)
# ============================================================
# Hors dev/test, node-api REFUSE de démarrer sans IA_SERVICE_TOKEN, et sans PG_SSL_CA
# quand DATABASE_SSL=true (python-ia refuse aussi sans IA_SERVICE_TOKEN).
# En dev uniquement, /health/deep est public.
SOULBAH_ENV=dev

# ============================================================
#  node-api : réseau, CORS, limites
# ============================================================
# Interface d'écoute. Défaut 127.0.0.1 (local uniquement) ; docker-compose force 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# Proxy de confiance (IP réelle du client pour la limitation de débit) :
# vide/false = connexion directe (défaut) ; true = tout X-Forwarded-For (proxy maîtrisé
# uniquement) ; n = nombre de sauts ; sinon liste d'IP/CIDR séparées par des virgules.
TRUST_PROXY=
# Port publié sur l'hôte par docker-compose pour node-api (python-ia/rust restent internes).
NODE_API_PORT=3000
# Origines web autorisées (CORS), séparées par des virgules. Vide = localhost:8080 / 127.0.0.1:8080.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Limitation de débit (requêtes / minute) : globale (par utilisateur, sinon par IP),
# agent local (poll/évènements), routes coûteuses (chat, génération, recherche…).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AGENT=1200
RATE_LIMIT_EXPENSIVE=20

# ============================================================
#  Base de données : Postgres de Supabase (chaîne de connexion directe / pooler)
# ============================================================
# Supabase > Project Settings > Database > Connection string (URI).
# Exemple : postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_SSL=true
# Vérification TLS du serveur Postgres : chemin d'un certificat CA (PEM), p.ex. le
# « SSL certificate » téléchargeable dans Supabase > Database settings. Si défini :
# rejectUnauthorized=true avec ce CA. Si vide : chiffré SANS vérification (avertissement
# au démarrage ; REFUS de démarrer hors dev/test). NB : un `sslmode=` dans DATABASE_URL
# prend le pas sur ce réglage.
PG_SSL_CA=
# Délai max d'une requête SQL (ms) — statement_timeout côté serveur.
PG_STATEMENT_TIMEOUT_MS=30000

# --- Auth Supabase (vérification des JWT côté Node, résultat mis en cache 15 s ;
#     POST /api/auth/logout l'invalide immédiatement) ---
SUPABASE_URL=https://ntvwbafvjgzsjoumtcmb.supabase.co
SUPABASE_ANON_KEY=

# ============================================================
#  Service IA (python-ia)
# ============================================================
# URL vue par node-api. Docker : http://python-ia:8000 (forcé par docker-compose).
IA_SERVICE_URL=http://localhost:8000
# Jeton partagé node-api → python-ia (en-tête x-ia-token). Le MÊME pour les deux services.
# OBLIGATOIRE hors SOULBAH_ENV=dev|test.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IA_SERVICE_TOKEN=
# Dossier média partagé : python-ia y écrit les MP4/PDF, node-api les sert sous /media/.
# Vide = backend/media. docker-compose utilise un volume partagé (python-ia : /app/media,
# node-api : /data/media en lecture seule).
MEDIA_DIR=
# Rétention des médias NON référencés par une formation (video_url/pdf_url), en jours.
# Purge à la maintenance horaire de node-api ; 0 = jamais. Volume en lecture seule
# (docker) : la purge est ignorée côté node-api.
MEDIA_RETENTION_DAYS=30

# ============================================================
#  Orchestration multi-fournisseurs d'IA (python-ia + chat de node-api)
#  Un fournisseur est ACTIVÉ dès que sa clé est renseignée.
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
XAI_API_KEY=
XAI_MODEL=grok-2-latest
QWEN_API_KEY=
QWEN_MODEL=qwen-max
# Modèle local (Ollama / LM Studio / vLLM) — activé si LOCAL_LLM_URL est défini
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_KEY=

# Fournisseur par défaut (sinon : 1er configuré). Routage par tâche : LLM_ROUTING (JSON).
# Ex : LLM_ROUTING={"code":"deepseek","chat":"openai","reasoning":"anthropic"}
LLM_DEFAULT_PROVIDER=
LLM_ROUTING=
# Fournisseurs qu'un CLIENT peut imposer (champ `provider` des requêtes), séparés par des
# virgules, en minuscules (lu par node-api ET python-ia). Vide = aucune surcharge : tout
# `provider` fourni est refusé (400).
LLM_ALLOWED_OVERRIDES=

# --- Routeur de modèles python-ia (LOT 1) ---
# Modèle par rôle : "[fournisseur:]modèle" (appliqué si le fournisseur retenu est celui du
# profil). Vides = défauts du routeur (planner/evaluator/vision : claude-opus-5-5 ; cheap : haiku).
LLM_MODEL_PLANNER=
LLM_MODEL_EVALUATOR=
LLM_MODEL_VISION=
LLM_MODEL_CHEAP=
# Effort de raisonnement par rôle (low|medium|high) ; vide = défaut du rôle.
LLM_EFFORT_PLANNER=
LLM_EFFORT_EVALUATOR=
LLM_EFFORT_VISION=
LLM_EFFORT_CHEAP=
LLM_EFFORT_DEFAULT=
# Repli sur panne (429, 5xx, délai, crédits) : ordre des fournisseurs et nombre de sauts.
# Jamais de repli quand un client a imposé `provider`.
LLM_FALLBACK_ORDER=anthropic,openai,gemini,mistral,deepseek,xai,qwen,local
LLM_MAX_HOPS=3
# Disjoncteur par fournisseur : N échecs consécutifs → ouvert pendant N secondes.
LLM_CB_THRESHOLD=3
LLM_CB_COOLDOWN_S=30
# Capacités déclarées (JSON) — vision=false par défaut : une image n'est jamais envoyée à
# un modèle non-vision. Ex. : {"openai:gpt-4o": {"vision": true}}
LLM_CAPABILITIES=
# Délai par appel fournisseur (s), tentatives SDK, plancher max_tokens des modèles à réflexion.
LLM_TIMEOUT_S=100
LLM_MAX_RETRIES=1
LLM_THINKING_MIN_MAX_TOKENS=16000
# node-api envoie l'en-tête x-deadline-ms (budget restant) : python-ia ne travaille jamais
# au-delà de l'abandon de node ; l'usage LLM revient dans l'en-tête x-llm-usage (journalisé).

# Synthèse vocale des vidéos de formation (python-ia, OpenAI TTS)
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Narrations TTS générées en parallèle (1–8).
VIDEO_TTS_CONCURRENCY=3
# Taille max d'un corps de requête accepté par python-ia (octets).
IA_MAX_BODY_BYTES=41943040

# Chat streaming de node-api (famille compatible OpenAI : openai|gemini|mistral|
# deepseek|xai|qwen|local). Vide = 1er configuré (OpenAI prioritaire).
CHAT_PROVIDER=
# Modèle du chat : appliqué UNIQUEMENT au fournisseur choisi par CHAT_PROVIDER
# (jamais à un fournisseur de repli d'un autre éditeur). Vide = <FOURNISSEUR>_MODEL.
CHAT_MODEL=
# Endpoint OpenAI (proxy compatible éventuel)
OPENAI_URL=https://api.openai.com/v1/chat/completions

# Embeddings de la base de connaissances (RAG) — utilisent OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_URL=https://api.openai.com/v1/embeddings

# ============================================================
#  Recherche web (moteur de recherche KB-first, service node-api)
#  Sans clé : la recherche se limite à la base de connaissances + synthèse du modèle.
#  Renseigner UNE clé suffit. WEB_SEARCH_PROVIDER force le choix (tavily|serper|brave).
# ============================================================
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Fournisseur de stockage de la base de connaissances (supabase aujourd'hui ; gcp plus tard)
KNOWLEDGE_STORE_PROVIDER=supabase

# ============================================================
#  Agent local & maintenance
# ============================================================
# Tâche 'in_progress' sans signe de vie depuis ce délai → remise en file (max 3 fois)
# par le reaper GLOBAL de node-api (verrou consultatif : une seule instance l'exécute).
AGENT_TASK_STALE_SECONDS=180
# Période du reaper (secondes, min 10).
REAPER_INTERVAL_SECONDS=60
# Formation/application bloquée en « Génération... »/« En cours » au-delà → 'Erreur'.
STALE_GENERATION_MINUTES=30

# ============================================================
#  Postgres LOCAL (uniquement pour la démo /api/analyze — facultatif)
# ============================================================
POSTGRES_USER=soulbah
POSTGRES_PASSWORD=soulbah
POSTGRES_DB=soulbah
