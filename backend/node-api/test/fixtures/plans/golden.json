{
  "description": "Jeux « golden » de validateDag (LOT 11, audit §13) : chaque cas est un plan brut, son contexte et le résultat attendu — \"ok\" ou des fragments qui DOIVENT figurer dans les erreurs.",
  "context": { "userId": "a0000000-0000-4000-8000-000000000001", "allowedDirs": ["C:\\w"], "sessionMaxLevel": "L2" },
  "cases": [
    {
      "name": "plan valide : observer puis agir avec critère",
      "plan": {
        "nodes": [
          { "key": "observe", "title": "Observer", "role": "desktop_operator", "security_level": "L1", "spec": { "steps": [{ "type": "screenshot" }] } },
          { "key": "act", "title": "Taper", "role": "desktop_operator", "security_level": "L2", "spec": { "steps": [{ "type": "type_text", "text": "bonjour" }] }, "acceptance_criteria": [{ "type": "ui_element_state", "window_title": "Bloc-notes" }] }
        ],
        "edges": [{ "from": "observe", "to": "act" }]
      },
      "expect": "ok"
    },
    {
      "name": "cycle",
      "plan": {
        "nodes": [
          { "key": "a", "title": "A", "role": "coder", "security_level": "L0" },
          { "key": "b", "title": "B", "role": "coder", "security_level": "L0" },
          { "key": "c", "title": "C", "role": "coder", "security_level": "L0" }
        ],
        "edges": [{ "from": "a", "to": "b" }, { "from": "b", "to": "c" }, { "from": "c", "to": "a" }]
      },
      "expect": ["cycle"]
    },
    {
      "name": "rôle inconnu",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "hacker", "security_level": "L0" }] },
      "expect": ["rôle inconnu « hacker »"]
    },
    {
      "name": "outil non autorisé pour le rôle",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "researcher", "security_level": "L1", "spec": { "steps": [{ "type": "write_file", "path": "C:\\w\\x.txt", "content": "x" }] }, "acceptance_criteria": [{ "type": "file_exists", "path": "C:\\w\\x.txt" }] }] },
      "expect": ["outil write_file non autorisé pour le rôle researcher"]
    },
    {
      "name": "niveau trop élevé : outil au-dessus du niveau déclaré",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "run_command", "program": "npm", "args": ["test"], "cwd": "C:\\w" }] }, "acceptance_criteria": [{ "type": "tests_pass" }] }] },
      "expect": ["outil run_command de niveau L2 au-dessus du niveau déclaré du nœud (L1)"]
    },
    {
      "name": "niveau trop élevé : plafond du rôle",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "researcher", "security_level": "L2", "acceptance_criteria": [{ "type": "llm_rubric", "rubric": "ok" }] }] },
      "expect": ["au-dessus du plafond du rôle researcher (L1)"]
    },
    {
      "name": "niveau trop élevé : plafond de la mission",
      "context": { "sessionMaxLevel": "L1" },
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L2", "spec": { "steps": [{ "type": "run_command", "program": "npm", "args": ["test"], "cwd": "C:\\w" }] }, "acceptance_criteria": [{ "type": "tests_pass" }] }] },
      "expect": ["au-dessus du plafond de la mission (L1)"]
    },
    {
      "name": "chemin hors workspace",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "write_file", "path": "C:\\Windows\\System32\\x.txt", "content": "x" }] }, "acceptance_criteria": [{ "type": "file_exists", "path": "C:\\Windows\\System32\\x.txt" }] }] },
      "expect": ["chemin hors des dossiers autorisés"]
    },
    {
      "name": "chemin de la deny-list dans le workspace",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "read_file", "path": "C:\\w\\.env" }] } }] },
      "expect": ["chemin interdit", ".env"]
    },
    {
      "name": "critères manquants pour une action à effet",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "move_file", "src": "C:\\w\\a", "dest": "C:\\w\\b" }] } }] },
      "expect": ["action à effet sans critère d'acceptation requis"]
    },
    {
      "name": "critères seulement facultatifs : refusé aussi",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "move_file", "src": "C:\\w\\a", "dest": "C:\\w\\b" }] }, "acceptance_criteria": [{ "type": "file_exists", "path": "C:\\w\\b", "required": false }] }] },
      "expect": ["sans critère d'acceptation requis"]
    },
    {
      "name": "critère invalide",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L0", "acceptance_criteria": [{ "type": "magic" }] }] },
      "expect": ["acceptance_criteria[0].type inconnu"]
    },
    {
      "name": "bureau sans observation préalable",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "desktop_operator", "security_level": "L2", "spec": { "steps": [{ "type": "click", "x": 10, "y": 10 }] }, "acceptance_criteria": [{ "type": "ui_element_state", "window_title": "x" }] }] },
      "expect": ["sans observation préalable"]
    },
    {
      "name": "observation par un ancêtre indirect : accepté",
      "plan": {
        "nodes": [
          { "key": "o", "title": "O", "role": "desktop_operator", "security_level": "L1", "spec": { "steps": [{ "type": "screenshot" }] } },
          { "key": "m", "title": "M", "role": "coder", "security_level": "L0" },
          { "key": "a", "title": "A", "role": "desktop_operator", "security_level": "L2", "spec": { "steps": [{ "type": "click", "x": 10, "y": 10 }] }, "acceptance_criteria": [{ "type": "ui_element_state", "window_title": "x" }] }
        ],
        "edges": [{ "from": "o", "to": "m" }, { "from": "m", "to": "a" }]
      },
      "expect": "ok"
    },
    {
      "name": "dépendance douce : n'observe pas",
      "plan": {
        "nodes": [
          { "key": "o", "title": "O", "role": "desktop_operator", "security_level": "L1", "spec": { "steps": [{ "type": "screenshot" }] } },
          { "key": "a", "title": "A", "role": "desktop_operator", "security_level": "L2", "spec": { "steps": [{ "type": "click", "x": 10, "y": 10 }] }, "acceptance_criteria": [{ "type": "ui_element_state", "window_title": "x" }] }
        ],
        "edges": [{ "from": "o", "to": "a", "kind": "soft" }]
      },
      "expect": ["sans observation préalable"]
    },
    {
      "name": "rôle exécuté par P1 avec des étapes",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "qa_reviewer", "security_level": "L0", "spec": { "steps": [{ "type": "wait", "seconds": 1 }] } }] },
      "expect": ["exécuté par le plan de contrôle, sans étapes"]
    },
    {
      "name": "étape d'un outil inconnu",
      "plan": { "nodes": [{ "key": "a", "title": "A", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "format_disk" }] } }] },
      "expect": ["format_disk"]
    },
    {
      "name": "plusieurs violations listées ensemble",
      "plan": { "nodes": [
        { "key": "a", "title": "A", "role": "hacker", "security_level": "L0" },
        { "key": "b", "title": "B", "role": "coder", "security_level": "L1", "spec": { "steps": [{ "type": "move_file", "src": "D:\\x", "dest": "D:\\y" }] } }
      ] },
      "expect": ["rôle inconnu", "chemin hors des dossiers autorisés", "sans critère d'acceptation requis"]
    },
    {"name": "LOT 12 : codeur en worktree, relecture QA, fusion testée — accepté", "plan": {"nodes": [{"key": "t1", "title": "T1", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_worktree", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\t1", "branch": "soulbah/s1/t1"}, {"type": "write_file", "path": "C:\\w\\wt\\t1\\mod.py", "content": "x = 1"}, {"type": "git_commit", "cwd": "C:\\w\\wt\\t1", "message": "soulbah:t1 travail"}]}, "acceptance_criteria": [{"type": "git_branch_contains", "branch": "soulbah/s1/t1", "text": "soulbah:t1"}]}, {"key": "review_t1", "title": "Relecture", "role": "qa_reviewer", "security_level": "L0", "spec": {"review_of_key": "t1"}}, {"key": "merge", "title": "Fusion", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_merge", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\integration", "source": "soulbah/s1/t1", "target": "soulbah/s1/integration", "test_program": "npm", "test_args": ["test"]}]}, "acceptance_criteria": [{"type": "tests_pass"}]}], "edges": [{"from": "t1", "to": "review_t1"}, {"from": "review_t1", "to": "merge"}]}, "expect": "ok"},
    {"name": "LOT 12 : fusion git sans relecture QA", "plan": {"nodes": [{"key": "t1", "title": "T1", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_worktree", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\t1", "branch": "soulbah/s1/t1"}, {"type": "write_file", "path": "C:\\w\\wt\\t1\\mod.py", "content": "x = 1"}, {"type": "git_commit", "cwd": "C:\\w\\wt\\t1", "message": "soulbah:t1 travail"}]}, "acceptance_criteria": [{"type": "git_branch_contains", "branch": "soulbah/s1/t1", "text": "soulbah:t1"}]}, {"key": "merge", "title": "Fusion", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_merge", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\integration", "source": "soulbah/s1/t1", "target": "soulbah/s1/integration", "test_program": "npm", "test_args": ["test"]}]}, "acceptance_criteria": [{"type": "tests_pass"}]}], "edges": [{"from": "t1", "to": "merge"}]}, "expect": ["fusion git sans relecture QA préalable"]},
    {"name": "LOT 12 : relecture en dépendance douce seulement : la fusion n'est pas protégée", "plan": {"nodes": [{"key": "t1", "title": "T1", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_worktree", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\t1", "branch": "soulbah/s1/t1"}, {"type": "write_file", "path": "C:\\w\\wt\\t1\\mod.py", "content": "x = 1"}, {"type": "git_commit", "cwd": "C:\\w\\wt\\t1", "message": "soulbah:t1 travail"}]}, "acceptance_criteria": [{"type": "git_branch_contains", "branch": "soulbah/s1/t1", "text": "soulbah:t1"}]}, {"key": "review_t1", "title": "Relecture", "role": "qa_reviewer", "security_level": "L0", "spec": {"review_of_key": "t1"}}, {"key": "merge", "title": "Fusion", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_merge", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\integration", "source": "soulbah/s1/t1", "target": "soulbah/s1/integration", "test_program": "npm", "test_args": ["test"]}]}, "acceptance_criteria": [{"type": "tests_pass"}]}], "edges": [{"from": "t1", "to": "review_t1"}, {"from": "review_t1", "to": "merge", "kind": "soft"}]}, "expect": ["fusion git sans relecture QA préalable"]},
    {"name": "LOT 12 : relecture d'un nœud inconnu", "plan": {"nodes": [{"key": "review_t1", "title": "Relecture", "role": "qa_reviewer", "security_level": "L0", "spec": {"review_of_key": "fantome"}}]}, "expect": ["ne désigne aucun nœud du plan"]},
    {"name": "LOT 12 : relecture sans dépendance dure vers le nœud relu", "plan": {"nodes": [{"key": "t1", "title": "T1", "role": "coder", "security_level": "L2", "spec": {"steps": [{"type": "git_worktree", "repo": "C:\\w\\app", "path": "C:\\w\\wt\\t1", "branch": "soulbah/s1/t1"}, {"type": "write_file", "path": "C:\\w\\wt\\t1\\mod.py", "content": "x = 1"}, {"type": "git_commit", "cwd": "C:\\w\\wt\\t1", "message": "soulbah:t1 travail"}]}, "acceptance_criteria": [{"type": "git_branch_contains", "branch": "soulbah/s1/t1", "text": "soulbah:t1"}]}, {"key": "review_t1", "title": "Relecture", "role": "qa_reviewer", "security_level": "L0", "spec": {"review_of_key": "t1"}}]}, "expect": ["doit dépendre (dépendance dure) du nœud relu « t1 »"]},
    {"name": "LOT 12 : identifiant brut review_of interdit dans un plan", "plan": {"nodes": [{"key": "review_t1", "title": "Relecture", "role": "qa_reviewer", "security_level": "L0", "spec": {"review_of": "a0000000-0000-4000-8000-000000000009"}}]}, "expect": ["spec.review_of interdit dans un plan"]},
    {"name": "LOT 12 : suppression de branche (L3) jamais planifiable par le codeur", "plan": {"nodes": [{"key": "del", "title": "Supprimer", "role": "coder", "security_level": "L3", "spec": {"steps": [{"type": "git_branch_delete", "repo": "C:\\w\\app", "branch": "soulbah/s1/t1", "force": true}]}, "acceptance_criteria": [{"type": "llm_rubric", "rubric": "branche supprimée"}]}]}, "expect": ["outil git_branch_delete non autorisé pour le rôle coder", "au-dessus du plafond du rôle coder (L2)", "au-dessus du plafond de la mission (L2)"]},
    {"name": "LOT 12 : inspection d'interface = observation avant d'agir", "plan": {"nodes": [{"key": "act", "title": "Taper", "role": "desktop_operator", "security_level": "L2", "spec": {"steps": [{"type": "ui_snapshot", "window_title": "Bloc-notes"}, {"type": "type_text", "text": "bonjour", "window_title": "Bloc-notes"}, {"type": "ui_snapshot", "window_title": "Bloc-notes"}]}, "acceptance_criteria": [{"type": "ui_element_state", "window_title": "Bloc-notes"}]}]}, "expect": "ok"},
    {"name": "LOT 12 : lecture web par le chercheur, sans effet", "plan": {"nodes": [{"key": "lire", "title": "Lire", "role": "researcher", "security_level": "L1", "spec": {"steps": [{"type": "browser_get", "url": "https://example.com/"}]}, "acceptance_criteria": [{"type": "http_status", "status": 200}]}]}, "expect": "ok"}
  ]
}
