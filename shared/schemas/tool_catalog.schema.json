{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulbah.local/schemas/tool_catalog.schema.json",
  "title": "Catalogue d'outils SoulBah",
  "description": "Forme de shared/tools/catalog.json, généré par scripts/gen_catalog.py depuis agent/skills/manifests.py. Les mots-clés utilisés ici sont ceux que gen_catalog.py sait valider (type, enum, const, pattern, required, properties, additionalProperties, items, minItems, maxItems, uniqueItems, minLength, minimum, exclusiveMinimum, anyOf, $ref).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "generated_from",
    "common_fields",
    "workspace_placeholder",
    "security_levels",
    "categories",
    "tools"
  ],
  "properties": {
    "catalog_version": { "$ref": "#/$defs/semver" },
    "generated_from": { "type": "string", "minLength": 1 },
    "common_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "workspace_placeholder": { "type": "string", "minLength": 1 },
    "security_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2", "L3"],
      "properties": {
        "L0": { "type": "string", "minLength": 1 },
        "L1": { "type": "string", "minLength": 1 },
        "L2": { "type": "string", "minLength": 1 },
        "L3": { "type": "string", "minLength": 1 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "level": { "enum": ["L0", "L1", "L2", "L3"] },
    "param_type": { "enum": ["string", "integer", "number", "boolean", "array"] },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "planner_note"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "planner_note": { "type": "string" }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "required", "is_path", "is_secret_text", "deprecated"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": {
          "anyOf": [
            { "$ref": "#/$defs/param_type" },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/param_type" }
            }
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "is_path": { "type": "boolean" },
        "is_secret_text": { "type": "boolean" },
        "deprecated": { "type": "boolean" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "clamped": { "const": true },
        "max_length": { "type": "integer", "minimum": 1 },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "$ref": "#/$defs/param_type" } }
        },
        "max_items": { "type": "integer", "minimum": 1 },
        "default": { "type": ["string", "number", "boolean"] },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
        },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confidence", "description"],
      "properties": {
        "kind": {
          "enum": [
            "command_output",
            "device_list",
            "dir_listing",
            "exit_code",
            "file_content",
            "file_path",
            "process",
            "screenshot",
            "self_report",
            "video_probe",
            "video_stats",
            "window_title"
          ]
        },
        "confidence": { "enum": ["high", "medium", "low", "none"] },
        "description": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "$ref": "#/$defs/identifier" } }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "aliases",
        "version",
        "description",
        "category",
        "security_level",
        "requires_desktop_input",
        "requires_confirmation",
        "idempotent",
        "timeout_s",
        "params",
        "required_any",
        "evidence",
        "examples",
        "known_errors"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/identifier" },
        "security_level": { "$ref": "#/$defs/level" },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "when"],
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "when": { "type": "string", "minLength": 1 }
          }
        },
        "requires_desktop_input": { "type": "boolean" },
        "requires_confirmation": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "timeout_s": {
          "anyOf": [
            { "type": "null" },
            { "type": "number", "exclusiveMinimum": 0 }
          ]
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/param" }
        },
        "required_any": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/example" }
        },
        "known_errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
