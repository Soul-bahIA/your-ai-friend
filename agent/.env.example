# --- Connexion à la file de tâches (backend Node) ---
SOULBAH_API_URL=http://localhost:3000

# Clé de l'agent (en-tête x-agent-key). Générez-la depuis la page Sécurité de l'app
# (« Clés de l'agent local »). Le backend la valide par hash et en déduit le user_id.
SOULBAH_AGENT_KEY=

# --- Comportement ---
SOULBAH_POLL_INTERVAL=5
# confirm = valider chaque action sensible | auto = ne rien demander
SOULBAH_PERMISSION_MODE=confirm
SOULBAH_DRY_RUN=false

# Dossiers autorisés pour les opérations sur fichiers (séparés par ; sous Windows, : sous Unix)
SOULBAH_ALLOWED_DIRS=C:\Users\SOUL-BAH\Desktop\soulbah_workspace
