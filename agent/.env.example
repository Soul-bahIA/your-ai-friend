# --- Connexion à la file de tâches (backend Node, /api/agent-tasks) ---
SOULBAH_API_URL=http://localhost:3000

# Clé de l'agent (en-tête x-agent-key). Générez-la depuis la page Sécurité de l'app
# (« Clés de l'agent local »). Le backend la valide par hash et en déduit le user_id.
# Une clé révoquée/invalide (401/403) est signalée comme telle ; après 3 refus
# consécutifs, l'agent s'arrête (code 3).
SOULBAH_AGENT_KEY=

# --- Comportement ---
# Intervalle de poll (s). En cas de backend injoignable : backoff exponentiel plafonné à 60 s.
SOULBAH_POLL_INTERVAL=5
# confirm = valider chaque action sensible | auto = ne rien demander pour fichiers/vidéo/captures
# (run_command, souris/clavier/fenêtres/applis et téléphone restent TOUJOURS confirmés en auto)
SOULBAH_PERMISSION_MODE=confirm
# Simulation d'un plan LOCAL uniquement : exige --plan fichier.json, aucune tâche n'est
# réclamée au serveur, aucune action n'est exécutée (résultat « simulated: true »).
SOULBAH_DRY_RUN=false

# Workspace : dossiers autorisés pour les fichiers, captures, vidéos et le cwd des commandes
# (séparés par ; sous Windows, : sous Unix). Vide = %USERPROFILE%\SoulbahWorkspace (créé au besoin).
# INTERDIT : le dépôt SoulBah, un de ses sous-dossiers ou un dossier qui le contient
# (l'agent refuse de démarrer). Même dans le workspace, la deny-list reste refusée :
# .env, clés privées (.ssh, *.pem, *.key, id_rsa…), dossiers .git, code de l'agent.
SOULBAH_ALLOWED_DIRS=

# Pré-autorise souris/clavier/fenêtres/lancement d'appli/téléphone sans confirmation
# (consentement explicite). Restent confirmés : raccourcis ouvrant un terminal ou « Exécuter »
# (Win+R, ctrl+shift+esc, ctrl+`…) et saisie de texte dans une fenêtre inconnue.
SOULBAH_ALLOW_INPUT_CONTROL=false

# Applications supplémentaires autorisées pour open_app (noms simples, séparés par des virgules ;
# jamais de chemin). Les shells (cmd, powershell, wscript…) restent interdits.
# Ces applications comptent aussi comme fenêtres « connues » pour la saisie de texte.
SOULBAH_ALLOWED_APPS=

# Délai max d'une étape (s), défaut 900. Au-delà : étape en échec, tâche arrêtée
# (pour run_command, tout l'arbre de processus est tué).
SOULBAH_STEP_TIMEOUT=900
# Délai de réponse à une confirmation (s), défaut 120. Sans réponse : refus par défaut.
SOULBAH_CONFIRM_TIMEOUT=120

# Tests : 1 = ne pas charger ce fichier .env (posé automatiquement par tests/conftest.py).
# SOULBAH_NO_DOTENV=1

# --- Sécurité (LOT 6, docs/LOT6_AGENT_NOTES.md) ---
# Où confirmer les actions sensibles : console (défaut, sur ce PC) | remote (approbation HMAC
# dans l'app web, liée au contenu exact de l'étape) | both (app d'abord, console si l'API V2 est absente).
SOULBAH_APPROVAL_MODE=console
# Valeurs à masquer dans tout journal, évènement et rapport (séparateur « ; »), p. ex. un canari de test.
SOULBAH_REDACT_VALUES=
# Dossier du fichier de clé chiffré par DPAPI (python soulbah_agent.py --store-key). Défaut : %LOCALAPPDATA%\Soulbah
# SOULBAH_SECRETS_DIR=

